{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentony.local/schemas/recovered-types-v1.json",
  "title": "OpenTony recovered retail type layouts",
  "type": "object",
  "required": ["version", "types"],
  "properties": {
    "version": {"const": 1},
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "confidence"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
          "kind": {"enum": ["fixed_layout", "variable_record", "alias", "opaque"]},
          "target": {"type": "string"},
          "size": {"type": ["integer", "null"], "minimum": 1},
          "confidence": {"enum": ["provisional", "inferred", "observed", "confirmed"]},
          "description": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["offset", "name", "type", "confidence"],
      "properties": {
        "offset": {"type": ["integer", "string"]},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
        "type": {"type": "string"},
        "confidence": {"enum": ["provisional", "inferred", "observed", "confirmed"]},
        "description": {"type": "string"},
        "overlay_group": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1}
      }
    }
  }
}
